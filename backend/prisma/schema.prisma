// S2 Nova backend schema. See /ARCHITECTURE.md §4 for the design rationale
// (identity split for multi-provider auth, minor-unit money columns,
// budgets vs. budget_recommendations separation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  PASSWORD
  GOOGLE

  @@map("auth_provider")
}

enum Currency {
  COP
  USD

  @@map("currency")
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM

  @@map("theme_preference")
}

// BANK_DEBIT/BANK_CREDIT replace the old flat BANK value — a bank wallet
// always needs the debit/credit distinction ("tarjeta" in both clients'
// copy), and NEQUI/DAVIPLATA moved here from PaymentMethod (they're wallets
// a user holds a balance in, not just a way of paying). See PaymentMethod's
// doc comment for how a transaction's payment method is derived from
// whichever of these the transaction's wallet is.
enum AccountType {
  CASH
  BANK_DEBIT
  BANK_CREDIT
  SAVINGS
  CRYPTO
  NEQUI
  DAVIPLATA
  OTHER

  @@map("account_type")
}

enum CategoryKind {
  INCOME
  EXPENSE
  BOTH

  @@map("category_kind")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER

  @@map("transaction_type")
}

// COMPLETED transactions affect their wallet's balance immediately;
// PLANNED ones ("Upcoming") are recorded but don't move money yet — the
// structural mechanism behind "Upcoming" per ARCHITECTURE.md's
// requirement to model these as real behavior, not a category.
enum TransactionStatus {
  COMPLETED
  PLANNED

  @@map("transaction_status")
}

// Interval a RecurringSeries fires on. Only used by RecurringSeries — a
// materialized Transaction just carries recurringSeriesId back to its
// definition, it doesn't repeat its own interval field (see the
// RecurringSeries model doc comment for why definition and occurrence are
// separate models).
enum RecurrenceInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@map("recurrence_interval")
}

// Set only on transactions representing money lent to, or borrowed from,
// someone else — tracked as outstanding until loanSettledAt is set.
enum LoanKind {
  LENT
  BORROWED

  @@map("loan_kind")
}

// A transaction's payment method is never chosen independently by a
// client — the route layer derives it from the transaction's account's
// AccountType (CASH->CASH, NEQUI->NEQUI, DAVIPLATA->DAVIPLATA,
// BANK_DEBIT/BANK_CREDIT/SAVINGS/CRYPTO/OTHER->BANK_TRANSFER; see
// `paymentMethodForAccountType` in backend/src/routes/transactions.ts).
// DEBIT_CARD/CREDIT_CARD are kept as valid enum values for old rows/reports
// only — no code path produces them anymore since a card wallet's method is
// BANK_TRANSFER, not a per-card distinction.
enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  NEQUI
  DAVIPLATA

  @@map("payment_method")
}

// Budget.kind (PLANS.md §4): CATEGORY budgets count expenses automatically by
// category scope + wallet set; CUSTOM budgets count only the movements the
// user assigned to them in Nuevo movimiento (Transaction.customBudgetId).
enum BudgetKind {
  CATEGORY
  CUSTOM

  @@map("budget_kind")
}

// GoalPlan end rule (PLANS.md §3): "Al cumplir la meta", "Después de" N
// aportes, "En una fecha".
enum GoalPlanEnd {
  GOAL
  COUNT
  DATE

  @@map("goal_plan_end")
}

enum AttachmentKind {
  IMAGE
  PDF

  @@map("attachment_kind")
}

enum BudgetPeriod {
  MONTHLY
  CUSTOM

  @@map("budget_period")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String?
  city            String?
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  authIdentities        AuthIdentity[]
  refreshTokens         RefreshToken[]
  preferences           UserPreferences?
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  budgetRecommendations BudgetRecommendation[]
  goals                 Goal[]
  recurringSeries       RecurringSeries[]
  currencies            UserCurrency[]
  categoryOverrides     CategoryOverride[]
  goalPlans             GoalPlan[]

  @@map("users")
}

// One user, many login methods — Google Sign-In links into an existing
// user by verified email instead of minting a duplicate account, and a
// future 'passkey' provider slots in without a schema change.
// See ARCHITECTURE.md §7 for the link-or-create flow this table supports.
model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  provider       AuthProvider
  providerUserId String?      @map("provider_user_id")
  credentialHash String?      @map("credential_hash")
  // Last time credential_hash was set — Web Ajustes shows "Cambiada hace…".
  credentialUpdatedAt DateTime? @map("credential_updated_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  // One login = one session. Every rotated token of that login carries the
  // same sessionId (also the access token's `sid` claim), so a session can
  // be listed and revoked as one row in Ajustes › Sesiones activas.
  sessionId   String    @default(uuid()) @map("session_id")
  deviceLabel String?   @map("device_label")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model UserPreferences {
  userId                String          @id @map("user_id")
  language              String          @default("es")
  currency              Currency        @default(COP)
  theme                 ThemePreference @default(SYSTEM)
  notifications         Boolean         @default(true)
  biometricLogin        Boolean         @default(false) @map("biometric_login")
  blurBalance           Boolean         @default(false) @map("blur_balance")
  autoLockMinutes       Int             @default(5) @map("auto_lock_minutes")
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at")
  tutorialCompletedAt   DateTime?       @map("tutorial_completed_at")
  // Mini-guides already dismissed ("inicio", "movimientos", …) — server-side
  // so a guide seen on Android isn't repeated on Web (ONBOARDING.md §3).
  // guidesOff is "Omitir guías".
  guidesSeen            String[]        @default([]) @map("guides_seen")
  guidesOff             Boolean         @default(false) @map("guides_off")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// "Wallet" in both clients' UI — kept as `Account`/`accounts` here since
// that's the table this project already had; no rename, just a UI-facing
// label difference (see backend/AGENTS.md).
model Account {
  id                  String      @id @default(uuid())
  userId              String      @map("user_id")
  name                String
  type                AccountType
  initialBalanceMinor BigInt      @map("initial_balance_minor")
  currentBalanceMinor BigInt      @map("current_balance_minor")
  // ISO 4217 code. Balances are kept in this currency's minor units
  // (CURRENCIES_AND_WALLETS.md §1). Existing wallets are COP.
  currency            String      @default("COP")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]     @relation("SourceAccount")
  incomingTransfers Transaction[]     @relation("TransferDestination")
  recurringSeries   RecurringSeries[]

  @@index([userId])
  @@map("accounts")
}

// user_id NULL = system-seeded category visible to every user (the fixed
// category list both clients already hardcode); non-null = reserved for a
// future user-defined category, not created by any flow yet.
//
// parentId NULL = a top-level category (the fixed 11 both clients hardcode);
// non-null = a subcategory hanging off one of those (e.g. "Taxi" under
// "Transportation"). Subcategories are additive only — Android's CategoryId
// enum still drives every top-level icon/label; a subcategory is resolved
// through its parent's slug, never given its own enum entry.
model Category {
  id        String       @id @default(uuid())
  userId    String?      @map("user_id")
  parentId  String?      @map("parent_id")
  // The taxonomy's stable dotted id (CATEGORY_SYSTEM.md §2), e.g.
  // "exp.food.groceries" — clients key everything on it. Unique per owner:
  // global rows (userId null) are unique by the seed, custom rows per user.
  slug      String
  name      String
  // Visual identity key (CAT_VIS in s2-categories.js, e.g. "food").
  icon      String
  color     String
  kind      CategoryKind
  isCustom  Boolean      @default(false) @map("is_custom")
  createdAt DateTime     @default(now()) @map("created_at")

  user                    User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                  Category?         @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Cascade)
  children                Category[]        @relation("CategoryParent")
  transactions            Transaction[]     @relation("TransactionCategory")
  subcategoryTransactions Transaction[]     @relation("TransactionSubcategory")
  budgets                 Budget[]
  products                Product[]
  recurringSeries         RecurringSeries[]   @relation("SeriesCategory")
  recurringSubSeries      RecurringSeries[]   @relation("SeriesSubcategory")
  overrides               CategoryOverride[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

// Per-user edits of a built-in category (Ajustes › Categorías): a label
// override, a different icon, or hidden from the Nuevo movimiento selector.
// The id never changes; history keeps showing the category.
model CategoryOverride {
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  name       String?
  icon       String?
  hidden     Boolean  @default(false)
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("category_overrides")
}

// Currencies the user enabled (Ajustes › Monedas). Exactly one isPrincipal:
// total balance, budgets and reports are shown in it.
model UserCurrency {
  userId      String   @map("user_id")
  code        String
  isPrincipal Boolean  @default(false) @map("is_principal")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
  @@map("user_currencies")
}

// Daily reference rate: 1 `base` = `rate` `quote`. There is no live FX feed
// yet; src/lib/currency.ts falls back to fixed reference rates when a day
// has no row.
model FxRate {
  base  String
  quote String
  date  DateTime @db.Date
  rate  Decimal  @db.Decimal(18, 6)

  @@id([base, quote, date])
  @@map("fx_rates")
}

// Global, not per-user — the same barcode refers to the same product for
// every S2 Nova user (ARCHITECTURE.md §11).
model Product {
  id          String   @id @default(uuid())
  barcode     String   @unique
  name        String
  brand       String?
  categoryId  String?  @map("category_id")
  description String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@map("products")
}

model Transaction {
  id                     String            @id @default(uuid())
  userId                 String            @map("user_id")
  accountId              String            @map("account_id")
  // Destination wallet; required only when type = TRANSFER (enforced in
  // the route layer, not the DB, since it's conditional on `type`).
  transferToAccountId    String?           @map("transfer_to_account_id")
  type                   TransactionType
  status                 TransactionStatus @default(COMPLETED)
  amountMinor            BigInt            @map("amount_minor")
  categoryId             String            @map("category_id")
  // Optional refinement under `categoryId` (e.g. "Taxi" under
  // "Transportation") — must be one of categoryId's own `children` (enforced
  // in the route layer, not the DB). categoryId always stays the top-level
  // category so existing budget/analytics aggregation-by-category is
  // unaffected by this field's presence or absence.
  subcategoryId          String?           @map("subcategory_id")
  productId              String?           @map("product_id")
  // Optional links — a transaction never has to belong to a budget or a
  // goal, per the product requirement that neither relation is mandatory.
  budgetId               String?           @map("budget_id")
  goalId                 String?           @map("goal_id")
  // Set only when this transaction was materialized from a recurring
  // definition (see RecurringSeries) — the series' own interval/next-due
  // date live there, not here, so "definition" and "occurrence" can't be
  // conflated into one row.
  recurringSeriesId      String?           @map("recurring_series_id")
  // Lent/Borrowed only.
  loanKind               LoanKind?         @map("loan_kind")
  counterpartyName       String?           @map("counterparty_name")
  dueDate                DateTime?         @map("due_date") @db.Date
  loanSettledAt          DateTime?         @map("loan_settled_at")
  // The repayment transaction created when this loan was settled — a real
  // opposite-direction transaction (see backend/src/routes/transactions.ts
  // `settleLoan`), not just a status flag, so the wallet balance actually
  // reflects the money coming back (LENT) or going out (BORROWED) without
  // touching or duplicating this original row.
  settledByTransactionId String?           @unique @map("settled_by_transaction_id")
  // Set on every settlement transaction created by POST
  // /transactions/:id/settle-loan (partial or final) — points back at the
  // original Lent/Borrowed row. `paid` for a loan is the sum of every
  // transaction with parentLoanId = that loan's id, which is how partial
  // repayments are tracked without a running balance column that could
  // drift out of sync with the settlement transactions themselves.
  parentLoanId           String?           @map("parent_loan_id")
  paymentMethod          PaymentMethod     @map("payment_method")
  description            String
  merchant               String?
  note                   String?
  transactionDate        DateTime          @map("transaction_date") @db.Date
  // Full date and time of the movement (NEW_MOVEMENT.md §4). transactionDate
  // stays as its calendar day for filtering and aggregates.
  occurredAt             DateTime?         @map("occurred_at")
  // Original currency of `amountMinor` (minor units of this currency). When it
  // differs from the wallet's, fxRate is wallet units per 1 movement unit and
  // walletAmountMinor is what the wallet balance moved by; otherwise both
  // are null and the wallet moved by amountMinor.
  currency               String            @default("COP")
  fxRate                 Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  walletAmountMinor      BigInt?           @map("wallet_amount_minor")
  // Income "De" source type: EMPLOYER, CLIENT, FAMILY, FRIEND, OTHER.
  counterpartyKind       String?           @map("counterparty_kind")
  customBudgetId         String?           @map("custom_budget_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                 Account          @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferToAccount       Account?         @relation("TransferDestination", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  category                Category         @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory             Category?        @relation("TransactionSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  product                 Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  budget                  Budget?          @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  customBudget            Budget?          @relation("CustomBudget", fields: [customBudgetId], references: [id], onDelete: SetNull)
  attachment              Attachment?
  goal                    Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  recurringSeries         RecurringSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  settledByTransaction    Transaction?     @relation("LoanSettlement", fields: [settledByTransactionId], references: [id], onDelete: SetNull)
  originalLoanTransaction Transaction?     @relation("LoanSettlement")
  parentLoan              Transaction?     @relation("LoanPartialSettlements", fields: [parentLoanId], references: [id], onDelete: SetNull)
  partialSettlements      Transaction[]    @relation("LoanPartialSettlements")

  @@index([userId, transactionDate])
  @@index([accountId])
  @@index([budgetId])
  @@index([goalId])
  @@index([recurringSeriesId])
  @@index([subcategoryId])
  @@index([parentLoanId])
  @@index([customBudgetId])
  @@map("transactions")
}

// Receipt attached to a movement ("Adjuntar comprobante"), one per movement
// in MVP. The file bytes live in the row: there is no object storage yet,
// and 10 MB per file keeps that reasonable.
model Attachment {
  id            String         @id @default(uuid())
  transactionId String         @unique @map("transaction_id")
  kind          AttachmentKind
  mime          String
  name          String
  size          Int
  data          Bytes
  createdAt     DateTime       @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// A recurring definition — "Netflix, $45,000/month" — kept separate from
// any actual Transaction row it produces, per the product requirement
// that definitions and materialized occurrences not be conflated (that
// conflation was Session 2's design; this replaces it). Nothing
// auto-generates a Transaction from this on a timer or on app start —
// materializing an occurrence is an explicit action
// (`POST /recurring-series/:id/confirm`, called from Android), which both
// creates the Transaction and advances nextOccurrenceDate, so re-opening
// the app never produces a duplicate.
model RecurringSeries {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  name               String
  type               TransactionType
  amountMinor        BigInt             @map("amount_minor")
  accountId          String             @map("account_id")
  categoryId         String             @map("category_id")
  subcategoryId      String?            @map("subcategory_id")
  paymentMethod      PaymentMethod      @default(BANK_TRANSFER) @map("payment_method")
  interval           RecurrenceInterval
  nextOccurrenceDate DateTime           @map("next_occurrence_date") @db.Date
  active             Boolean            @default(true)
  // "Termina" (NEW_MOVEMENT.md §5): after `occurrences` materialized
  // movements, on `endDate`, or never (both null). occurrencesDone counts
  // confirmed and skipped dates.
  occurrences        Int?
  occurrencesDone    Int                @default(0) @map("occurrences_done")
  endDate            DateTime?          @map("end_date") @db.Date
  // "Registrar automáticamente": due dates are recorded as COMPLETED
  // movements the next time the user's data is read, instead of waiting for
  // "Confirmar".
  autoConfirm        Boolean            @default(false) @map("auto_confirm")
  currency           String             @default("COP")
  note               String?
  counterpartyName   String?            @map("counterparty_name")
  counterpartyKind   String?            @map("counterparty_kind")
  customBudgetId     String?            @map("custom_budget_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category      @relation("SeriesCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory  Category?     @relation("SeriesSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@map("recurring_series")
}

// A named envelope like "Vacation" (`name`), still anchored to one
// category+period for its default progress computation. Transactions may
// also link to it directly via `transaction.budgetId` — see
// backend/src/routes/budgets.ts `computeSpent` for how the two signals
// combine without double-counting.
model Budget {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String?
  kind        BudgetKind   @default(CATEGORY)
  // Scope for CATEGORY budgets: a parent ("Todas", every child counts) or a
  // single subcategory. Null for CUSTOM budgets.
  categoryId  String?      @map("category_id")
  // Plan icon key (PLAN_ICONS) for CUSTOM budgets.
  icon        String?
  // Wallets whose expenses count; empty = all wallets.
  walletIds   String[]     @default([]) @map("wallet_ids")
  amountMinor BigInt       @map("amount_minor")
  // MONTHLY resets on the 1st and runs from startDate on (endDate null);
  // CUSTOM covers startDate..endDate with no reset.
  period      BudgetPeriod @default(MONTHLY)
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  // Optional cosmetic override from a small fixed client-side palette (see
  // android BudgetGoalTheme.kt) — purely visual, decoupled from `category`,
  // which stays the sole driver of spend-progress computation.
  themeIcon   String?      @map("theme_icon")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  assigned     Transaction[] @relation("CustomBudget")

  @@index([userId])
  @@map("budgets")
}

// A suggested split (e.g. 50/30/20), stored separately from real `budgets`
// per the product requirement that a recommendation is never assumed to be
// correct for every user — accepting one is a separate action that creates
// real Budget rows (see ARCHITECTURE.md §"Budget suggestions").
model BudgetRecommendation {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  strategy           String    @default("50-30-20")
  needsPct           Decimal   @map("needs_pct") @db.Decimal(5, 2)
  wantsPct           Decimal   @map("wants_pct") @db.Decimal(5, 2)
  savingsPct         Decimal   @map("savings_pct") @db.Decimal(5, 2)
  basedOnIncomeMinor BigInt?   @map("based_on_income_minor")
  acceptedAt         DateTime? @map("accepted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("budget_recommendations")
}

// A savings/payoff target like "Car Payment". Progress is computed from
// linked transactions (sum of transaction.amountMinor where goalId = this
// goal), not stored, matching how Budget progress is computed — avoids a
// second write path that could drift from the transactions themselves.
model Goal {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  name              String
  targetAmountMinor BigInt    @map("target_amount_minor")
  targetDate        DateTime? @map("target_date") @db.Date
  // Plan icon key (PLAN_ICONS in s2-categories.js), suggested from the name
  // (PLANS.md §1). Migrated from the legacy goal category in themeIcon.
  icon               String    @default("other")
  // Legacy goal category; kept one release for the migration, no longer read.
  themeIcon          String?   @map("theme_icon")
  // "Monto inicial": counts toward progress without being a movement.
  initialAmountMinor BigInt    @default(0) @map("initial_amount_minor")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  plan         GoalPlan?

  @@index([userId])
  @@map("goals")
}

// "Aporte periódico" (PLANS.md §3). With autoConfirm false each due date
// waits for "Confirmar aporte" / "Omitir esta vez"; with autoConfirm true the
// contribution is recorded the next time the user's data is read.
model GoalPlan {
  goalId       String             @id @map("goal_id")
  userId       String             @map("user_id")
  amountMinor  BigInt             @map("amount_minor")
  frequency    RecurrenceInterval
  accountId    String             @map("account_id")
  startDate    DateTime           @map("start_date") @db.Date
  endMode      GoalPlanEnd        @default(GOAL) @map("end_mode")
  count        Int?
  endDate      DateTime?          @map("end_date") @db.Date
  autoConfirm  Boolean            @default(false) @map("auto_confirm")
  nextDate     DateTime           @map("next_date") @db.Date
  doneCount    Int                @default(0) @map("done_count")
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goal_plans")
}
