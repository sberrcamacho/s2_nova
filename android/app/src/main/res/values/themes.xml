<resources>
    <!-- Base theme for the single Compose activity. All real theming (colors,
         typography, light/dark) lives in ui/theme/Theme.kt — this just needs
         to be a Material-derived theme with no action bar. -->
    <style name="Theme.S2Nova" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- System splash screen (androidx.core.splashscreen), shown before any
         Compose content exists. Light variant: white background + the
         violet glyph rendered directly (no icon background layer/card) so
         it respects the system's day/night setting instead of always
         showing the launcher icon's fixed dark card. installSplashScreen()
         switches to Theme.S2Nova once the first frame is drawn. -->
    <style name="Theme.S2Nova.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.S2Nova</item>
    </style>
</resources>
