<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 31 (Android 12+), so this is the only backup config needed —
  the legacy fullBackupContent mechanism only applies below API 31.
  Excludes SessionStore's DataStore file (see data/local/SessionStore.kt):
  it holds the plaintext access/refresh tokens, which must never end up in
  Android Auto Backup or a device-to-device transfer alongside everything
  else allowBackup="true" would otherwise include.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/s2nova_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/s2nova_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
